{
  "name": "nuxt-front-coepp",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "setup": "bash scripts/setup.sh",
    "dev": "concurrently -n back,front -c blue,green -k \"npm:dev:back\" \"npm:dev:front\"",
    "dev:win": "concurrently -n back,front -c blue,green -k \"npm:dev:back:win\" \"npm:dev:front\"",
    "dev:back": "cd ../python-back-coepp && .venv/bin/uvicorn app.main:app --port 8001 --reload",
    "dev:back:win": "cd ../python-back-coepp && .venv\\Scripts\\python -m uvicorn app.main:app --port 8001 --reload",
    "dev:front": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "api:sync": "node scripts/sync-api-contract.mjs",
    "api:types": "openapi-typescript docs/api/openapi.yaml -o app/shared/api/schema.d.ts",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "test": "vitest run"
  },
  "dependencies": {
    "@pinia/nuxt": "^1.0.2",
    "@tanstack/vue-query": "^5.102.8",
    "axios": "^1.20.0",
    "nuxt": "^4.5.2",
    "pinia": "^4.0.3",
    "vue": "^3.5.42",
    "vue-i18n": "^11.4.10",
    "vue-router": "^5.3.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vue/test-utils": "^2.5.0",
    "concurrently": "^9.1.2",
    "eslint": "^10.9.1",
    "happy-dom": "^20.12.2",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  }
}
